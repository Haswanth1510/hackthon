# Stylic.AI — Environment Configuration Template
# Copy this file to `.env` and fill in your real API keys.
# ⚠️ NEVER commit your real `.env` file to version control.

# ─────────────────────────────────────────────────────────────────
# PRIMARY AI ENGINES (Google Gemini Multimodal Flash)
# Split across two keys to prevent rate-limit contention:
# - GEMINI_API_KEY_SKIN: Dedicated key for clinical skin analysis
# - GEMINI_API_KEY_FASHION: Dedicated key for fashion & outfit styling
# Get keys from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_KEY_SKIN=
GEMINI_API_KEY_FASHION=
GEMINI_MODEL=gemini-flash-lite-latest

# ─────────────────────────────────────────────────────────────────
# SECONDARY / BACKUP AI ENGINE (Groq Cloud — Qwen3 Vision)
# Get your key from: https://console.groq.com/keys
# ─────────────────────────────────────────────────────────────────
GROK_API_KEY=
GROQ_API_KEY=
GROK_MODEL=qwen/qwen3.8-27b
GROK_API_URL=https://api.groq.com/openai/v1/chat/completions

# ─────────────────────────────────────────────────────────────────
# ROBOFLOW INFERENCE API (Skin Condition Detection)
# Sign up at: https://roboflow.com
# ─────────────────────────────────────────────────────────────────
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=skin-problem-detection-multiple-clean/2
ROBOFLOW_API_URL=https://serverless.roboflow.com

# ─────────────────────────────────────────────────────────────────
# SECURITY — JWT Secret (change this to a long random string in prod)
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production

# ─────────────────────────────────────────────────────────────────
# AFFILIATE LINKS & AMAZON PRODUCT ADVERTISING API (PA-API v5)
# ─────────────────────────────────────────────────────────────────
AMAZON_AFFILIATE_TAG=your-amazon-affiliate-tag-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1
FLIPKART_AFFILIATE_ID=your-flipkart-affiliate-id

# ─────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────
PORT=8008
HOST=127.0.0.1
